# ==============================================================================
# pz-server-docker - Variables de ENTORNO (solo INFRAESTRUCTURA)
# ------------------------------------------------------------------------------
# Toda la configuración del JUEGO (nombre del servidor, memoria, modo
# Steam/No-Steam, credenciales, rama, mods, horarios, RCON...) se configura
# desde la INTERFAZ WEB (Setup/Ajustes) y se persiste en el volumen ./pz-config.
#
# No añadas aquí variables de juego: el panel las sobrescribe desde la web.
# ==============================================================================

# --- Zona horaria del contenedor ---
TZ=America/Guayaquil

# --- Permisos de archivos (opcional) ---
PUID=1000
PGID=1000

# --- Panel Web (infraestructura) ---
# El panel es el ÚNICO método de gestión del servidor.
PANEL_USER=admin
PANEL_PASSWORD=adminpassword

# --- Límite de RAM del contenedor (ajustar según RAM del host / WSL) ---
MEM_LIMIT=7g
